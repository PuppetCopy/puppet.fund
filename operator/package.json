{
  "name": "@puppet.fund/operator",
  "version": "0.2.0",
  "license": "BUSL-1.1",
  "description": "Build autonomous trading operators on Puppet",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "bun": ">=1.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "test": "bun test",
    "tsgo:check": "tsgo --noEmit"
  },
  "dependencies": {
    "viem": "catalog:"
  },
  "devDependencies": {
    "@puppet/contracts": "workspace:*",
    "@puppet/sdk": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "0.22.2",
    "typescript": "catalog:"
  },
  "keywords": [
    "puppet",
    "operator",
    "trading",
    "defi",
    "gmx",
    "ethereum"
  ]
}
