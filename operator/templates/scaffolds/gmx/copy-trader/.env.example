# REQUIRED: the GMX account this bot copies (any GMX trader's address).
TRADER_ACCOUNT=0x

# DRY-RUN IS THE DEFAULT (even without a .env): the bot runs the full decision and order
# pipeline and logs every order it would place, but dispatches nothing. Set DRY_RUN=0 to
# trade live.
DRY_RUN=1

# Pairing carries your session key (in memory only), the matchmaker and oracle endpoints,
# the token registry and the trading account you selected. `bun run dev` prints a link you open on the site to authorize.

# PAIR_URL defaults to https://puppet.fund; set it to pair against a local dev site:
# PAIR_URL=http://localhost:3000

# The public Arbitrum endpoint is rate-limited; set your own for anything beyond a first run.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
