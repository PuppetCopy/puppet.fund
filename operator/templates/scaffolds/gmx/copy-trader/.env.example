# REQUIRED: the GMX account this bot copies (any GMX trader's address).
TRADER_ACCOUNT=0x

# Pairing carries everything: your session key (in memory only), your fund identity, the
# matchmaker endpoint, and the token registry. `bun run dev` prints a link you open on the
# site to authorize — nothing below is required.
#
# PAIR_URL defaults to https://puppet.fund; set it to pair against a local dev site:
# PAIR_URL=http://localhost:3000

# RPC defaults to the public Arbitrum endpoint, which is rate-limited; set your own for
# anything beyond a first run:
# ARBITRUM_RPC_URL=https://...
