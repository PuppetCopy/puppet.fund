{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": [
      "bun"
    ],
    "paths": {
      "@puppet.fund/operator": [
        "../src/index.ts"
      ],
      "@puppet.fund/operator/gmx": [
        "../src/gmx/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "scaffolds/*/*/src"
  ]
}
