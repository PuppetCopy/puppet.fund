{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "types": ["bun"]
  },
  "include": ["src", "vite.config.ts"]
}
