# REQUIRED: the GMX account this bot copies (any GMX trader's address).
TRADER_ACCOUNT=0x

# Pairing is the default: `bun run dev` prints a link you open on the site to
# authorize. The site hands the operator its matchmaker/indexer/rpc endpoints and
# your session key (in memory only) — nothing below is required. SITE_URL defaults
# to https://puppet.fund; set it to pair against a local dev site instead.
# SITE_URL=http://localhost:3000
#
# PAIR_PORT=42071  # loopback port the printed pairing link uses (default 42071)

# Override an endpoint the site would otherwise supply over the tunnel (optional):
# MATCHMAKER_WS_URL=wss://...
# INDEXER_ENDPOINT=https://.../api/indexer-gql
# ARBITRUM_RPC_URL=https://...

# Headless (no browser pairing): authorize a key on the site, then set it here
# along with all three endpoints above. The human still creates and funds the
# master on the site. WARNING: this writes your raw session key to .env on disk,
# losing the memory-only guarantee — prefer `bun run dev` (browser pairing) unless
# you are running unattended.
# OPERATOR_SIGNER_KEY=0x...
# OPERATOR_USER=0x...
